{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    // Test files run under Node (via Vitest) and sometimes need fs/path/url
    // for fixture loading — safe to include for src/ too, it only adds
    // ambient types, it doesn't force any file to use them.
    // "@testing-library/jest-dom" adds the toBeInTheDocument()-style
    // matcher types used across component tests.
    "types": ["node", "@testing-library/jest-dom"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests/unit", "tests/integration"]
}
